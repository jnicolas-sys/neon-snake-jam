";
let gameMusic=new Audio(GAME_MUSIC_SRC);
gameMusic.loop=true;
gameMusic.preload='auto';
gameMusic.volume=.252;

function ensureMusic(){
  if(musicCtx)return;
  musicCtx=new (window.AudioContext||window.webkitAudioContext)();
  musicMaster=musicCtx.createGain();
  musicMaster.gain.value=.62;
  musicMaster.connect(musicCtx.destination);
}
async function toggleMusic(){
  ensureMusic();
  if(musicCtx.state==='suspended')await musicCtx.resume();
  musicOn=!musicOn;
  const b=document.getElementById('musicBtn');
  if(b)b.textContent=musicOn?'♫ MÚSICA ✓':'♫ MÚSICA';
  if(musicOn){
    try{await gameMusic.play()}catch(e){console.warn(e)}
  }else{
    gameMusic.pause();
  }
  try{localStorage.setItem('nse_music',musicOn?'1':'0')}catch(e){}
}
const mb=document.getElementById('musicBtn');if(mb){mb.onclick=toggleMusic;mb.textContent='♫ MÚSICA ✓';}



const coverScreen=document.getElementById('coverScreen');
const coverPlay=document.getElementById('coverPlay');
if(coverPlay)coverPlay.onclick=async()=>{
 coverScreen.classList.add('off');
 ensureMusic();
 if(musicCtx && musicCtx.state==='suspended')await musicCtx.resume();
 musicOn=coverMusicWanted;
 if(musicOn){try{await gameMusic.play()}catch(e){}}
 else gameMusic.pause();
 const mb=document.getElementById('musicBtn');if(mb)mb.textContent=musicOn?'♫ MÚSICA ✓':'♫ MÚSICA';
};


const coverSound=document.getElementById('coverSound');
const mapToggle=document.getElementById('showMap');
const miniMap=document.getElementById('map');
if(mapToggle){mapToggle.checked=false;if(miniMap)miniMap.style.display='none';}
let coverMusicWanted=true;
if(coverSound){
  coverSound.classList.remove('off');
  coverSound.onclick=async()=>{
    coverMusicWanted=!coverMusicWanted;
    coverSound.classList.toggle('off',!coverMusicWanted);
    ensureMusic();
    if(musicCtx && musicCtx.state==='suspended')await musicCtx.resume();
    musicOn=coverMusicWanted;
    if(musicOn){try{await gameMusic.play()}catch(e){}}
    else gameMusic.pause();
    const mb=document.getElementById('musicBtn');if(mb)mb.textContent=musicOn?'♫ MÚSICA ✓':'♫ MÚSICA';
  };
}


if(coverScreen){
 const startCoverMusic=async()=>{
   if(!coverMusicWanted)return;
   ensureMusic();
   if(musicCtx && musicCtx.state==='suspended')await musicCtx.resume();
   musicOn=true;
   try{await gameMusic.play()}catch(e){}
   const mb=document.getElementById('musicBtn');if(mb)mb.textContent='♫ MÚSICA ✓';
 };
 // Intento inmediato. Si el navegador veta autoplay, el primer toque lo desbloquea.
 startCoverMusic();
 coverScreen.addEventListener('pointerdown',startCoverMusic,{once:true});
}

</script></body></html>